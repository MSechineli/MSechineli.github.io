---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title={`About — ${siteConfig.author}`}>
  <article class="about-page">
    <header class="about-header">
      <h1 class="page-title">Sobre mim</h1>
      <p class="page-subtitle">TODO: uma frase sobre você.</p>
    </header>

    <div class="about-content">
      <h2>Quem sou</h2>
      <p>
        TODO: Olá! Eu sou <strong>{siteConfig.author}</strong>. Conte aqui o que você faz, onde trabalha e o que te interessa.
      </p>

      <h2>Sobre este blog</h2>
      <p>
        TODO: Sobre o que você vai escrever e para quem.
      </p>

      <h2>Contato</h2>
      <ul>
        {siteConfig.socialLinks.github && <li>GitHub: <a href={siteConfig.socialLinks.github} target="_blank" rel="noopener noreferrer">{siteConfig.socialLinks.github.replace('https://', '')}</a></li>}
        {siteConfig.socialLinks.linkedin && <li>LinkedIn: <a href={siteConfig.socialLinks.linkedin} target="_blank" rel="noopener noreferrer">{siteConfig.socialLinks.linkedin.replace('https://', '')}</a></li>}
        {siteConfig.socialLinks.email && <li>E-mail: <a href={`mailto:${siteConfig.socialLinks.email}`}>{siteConfig.socialLinks.email}</a></li>}
      </ul>

      <p>
        <em>Este site usa o tema <a href="https://github.com/rnt-rez/minrock" target="_blank" rel="noopener noreferrer">Minrock</a> para Astro.</em>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .about-page {
    padding-top: 1rem;
  }

  .about-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 2.25rem;
  }

  .page-subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .about-content {
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .manifesto-quote {
    margin: 1.75rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-surface);
    border-radius: 0 8px 8px 0;
    font-style: normal;
  }

  .manifesto-author {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }
</style>
